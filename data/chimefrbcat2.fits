SIMPLE  =                    T / Standard FITS format                           BITPIX  =                    8 / Character data                                 NAXIS   =                    1 / Text string                                    NAXIS1  =                10427 / Number of characters                           EXTEND  =                    T / There are standard extensions                  VOTMETA =                    T / Table metadata in VOTable format               COMMENT                                                                         COMMENT The data in this primary HDU consists of bytes which                    COMMENT comprise a VOTABLE document.                                            COMMENT The VOTable describes the metadata of the table contained               COMMENT in the following BINTABLE extension.                                    COMMENT Such a BINTABLE extension can be used on its own as a perfectly         COMMENT good table, but the information from this HDU may provide some          COMMENT useful additional metadata.                                             COMMENT There is one following BINTABLE.                                        NTABLE  =                    1 / Number of following BINTABLE HDUs              END                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             <?xml version="1.0" encoding="utf-8"?>
<!-- Produced with astropy.io.votable version 6.1.7
     http://www.astropy.org/ -->
<VOTABLE version="1.4" xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/VOTable/VOTable-1.4.xsd">
 <RESOURCE type="meta">
  
  <TABLE ID="chimefrbcat2" name="The Second CHIME/FRB Catalog of Fast Radio Bursts">
   <FIELD arraysize="16" datatype="char" name="tns_name">
    <DESCRIPTION>
     Transient Name Server name
    </DESCRIPTION>
   </FIELD>
   <FIELD arraysize="16" datatype="char" name="previous_name">
    <DESCRIPTION>
     Previous name, if applicable
    </DESCRIPTION>
   </FIELD>
   <FIELD arraysize="16" datatype="char" name="repeater_name">
    <DESCRIPTION>
     Associated repeater name, if applicable
    </DESCRIPTION>
   </FIELD>
   <FIELD arraysize="16" datatype="char" name="event_id">
    <DESCRIPTION>
     CHIME/FRB internal event identifier
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="int" name="sub_num">
    <DESCRIPTION>
     Sub-burst number (0 for single-burst FRBs; otherwise, assigned in
     chronological order)
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="ra" unit="deg">
    <DESCRIPTION>
     Right ascension in decimal degrees (J2000)
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="ra_err" unit="deg">
    <DESCRIPTION>
     Uncertainty in ra in degrees of arc
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="dec" unit="deg">
    <DESCRIPTION>
     Declination in decimal degrees (J2000)
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="dec_err" unit="deg">
    <DESCRIPTION>
     Uncertainty in dec
    </DESCRIPTION>
   </FIELD>
   <FIELD arraysize="256" datatype="char" name="ra_dec_notes">
    <DESCRIPTION>
     Notes on source localization
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="gl" unit="deg">
    <DESCRIPTION>
     Galactic longitude
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="gb" unit="deg">
    <DESCRIPTION>
     Galactic latitude
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="exp_up" unit="h">
    <DESCRIPTION>
     Exposure for upper transit of source
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="exp_up_err" unit="h">
    <DESCRIPTION>
     Uncertainty in exp_up
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="exp_low" unit="h">
    <DESCRIPTION>
     Exposure for lower transit of source
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="exp_low_err" unit="h">
    <DESCRIPTION>
     Uncertainty in exp_low
    </DESCRIPTION>
   </FIELD>
   <FIELD arraysize="256" datatype="char" name="exp_notes">
    <DESCRIPTION>
     Notes on exposure estimates
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="bonsai_snr">
    <DESCRIPTION>
     Detection S/N
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="bonsai_dm" unit="pc.cm-3">
    <DESCRIPTION>
     Detection dispersion measure
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="low_ft_68" unit="Jy.ms">
    <DESCRIPTION>
     Fluence above which 68% of lower-transit bursts would have been
     detected, lower limit
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="up_ft_68" unit="Jy.ms">
    <DESCRIPTION>
     Fluence above which 68% of upper-transit bursts would have been
     detected, lower limit
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="low_ft_95" unit="Jy.ms">
    <DESCRIPTION>
     Fluence above which 95% of lower-transit bursts would have been
     detected, lower limit
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="up_ft_95" unit="Jy.ms">
    <DESCRIPTION>
     Fluence above which 95% of upper-transit bursts would have been
     detected, lower limit
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="snr_fitb">
    <DESCRIPTION>
     S/N determined using fitting algorithm fitburst
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="dm_fitb" unit="pc.cm-3">
    <DESCRIPTION>
     Dispersion measure determined using fitting algorithm fitburst
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="dm_fitb_err" unit="pc.cm-3">
    <DESCRIPTION>
     Uncertainty in dm_fitb
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="dm_exc_ne2001" unit="pc.cm-3">
    <DESCRIPTION>
     Dispersion measure excess between dm_fitb, or bonsai_dm if
     dm_fitb unavailable, and NE2001 assuming best-fit sky position of
     source
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="dm_exc_ymw16" unit="pc.cm-3">
    <DESCRIPTION>
     Dispersion measure excess between dm_fitb, or bonsai_dm if
     dm_fitb unavailable, and YMW16 assuming best-fit sky position of
     source
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="bc_width" unit="s">
    <DESCRIPTION>
     Boxcar width of pulse
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="scat_time" unit="s">
    <DESCRIPTION>
     Scattering time at 400.1953125 MHz
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="scat_time_err" unit="s">
    <DESCRIPTION>
     Uncertainty in scat_time
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="flux" unit="Jy">
    <DESCRIPTION>
     Maximum of band-averaged flux-density time series within burst
     window, lower limit
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="flux_err" unit="Jy">
    <DESCRIPTION>
     Uncertainty in flux
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="fluence" unit="Jy.ms">
    <DESCRIPTION>
     Integral of band-averaged flux-density time series over burst
     window, lower limit
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="fluence_err" unit="Jy.ms">
    <DESCRIPTION>
     Uncertainty in fluence
    </DESCRIPTION>
   </FIELD>
   <FIELD arraysize="256" datatype="char" name="fluence_notes">
    <DESCRIPTION>
     Notes on flux and fluence estimates
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="int" name="fluence_win_extended">
    <DESCRIPTION>
     Flag for events where burst window was extended during flux and
     fluence estimation (1 = window extended, 0 = window not extended)
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="mjd_400" unit="d">
    <DESCRIPTION>
     Time of arrival at topocentric CHIME location referenced to
     400.1953125 MHz for specific sub-burst; MJD UTC
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="mjd_400_err" unit="d">
    <DESCRIPTION>
     Uncertainty in mjd_400
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="mjd_inf" unit="d">
    <DESCRIPTION>
     Time of arrival at topocentric CHIME location referenced to
     infinite frequency for specific sub-burst; MJD UTC
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="mjd_inf_err" unit="d">
    <DESCRIPTION>
     Uncertainty in mjd_inf
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="width_fitb" unit="s">
    <DESCRIPTION>
     Width of sub-burst using fitburst
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="width_fitb_err" unit="s">
    <DESCRIPTION>
     Uncertainty in width_fitb
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="sp_idx">
    <DESCRIPTION>
     Spectral index for sub-burst
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="sp_idx_err">
    <DESCRIPTION>
     Uncertainty in sp_idx
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="sp_run">
    <DESCRIPTION>
     Spectral running for sub-burst
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="sp_run_err">
    <DESCRIPTION>
     Uncertainty in sp_run
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="high_freq" unit="MHz">
    <DESCRIPTION>
     Highest frequency where best-fit spectral model for sub-burst
     exceeds 10% of maximum, clipped at band edge
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="low_freq" unit="MHz">
    <DESCRIPTION>
     Lowest frequency where best-fit spectral model for sub-burst
     exceeds 10% of maximum, clipped at band edge
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="peak_freq" unit="MHz">
    <DESCRIPTION>
     Frequency of maximum of best-fit spectral model for sub-burst
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="chi_sq">
    <DESCRIPTION>
     chi-squared from fitburst
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="int" name="dof">
    <DESCRIPTION>
     Number of degrees of freedom in fitburst
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="float" name="flag_frac">
    <DESCRIPTION>
     Fraction of spectral channels flagged in fitburst
    </DESCRIPTION>
   </FIELD>
   <FIELD arraysize="256" datatype="char" name="notes_fitb">
    <DESCRIPTION>
     Notes or comments on fitburst results
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="int" name="intrachan_flag">
    <DESCRIPTION>
     Flag for events where intrachannel dispersion was not modeled
     during fit (1 = unmodeled, 0 = modeled)
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="int" name="excluded_flag">
    <DESCRIPTION>
     Flag for events that should be excluded from parameter inference
     due to non-nominal telescope operation (1 = excluded, 0 =
     included)
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="int" name="sidelobe_flag">
    <DESCRIPTION>
     Flag for events that were detected in sidelobes of CHIME primary
     beam (1 = sidelobe, 0 = mainlobe)
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="int" name="citizen_science_flag">
    <DESCRIPTION>
     Flag for low S/N events first identified by citizen scientists on
     Zooniverse platform (1 = citizen science detection, 0 = regular
     detection)
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="int" name="catalog1_flag">
    <DESCRIPTION>
     Flag indicating whether event was included in Catalog 1 (1 =
     included, 0 = not included)
    </DESCRIPTION>
   </FIELD>
   <FIELD datatype="int" name="catalog1_param_flag">
    <DESCRIPTION>
     Flag indicating whether fitburst and/or flux/fluence pipeline
     results are taken from Catalog 1  (1 = Catalog 1, 0 = Catalog 2)
    </DESCRIPTION>
   </FIELD>
  </TABLE>
 </RESOURCE>
</VOTABLE>
