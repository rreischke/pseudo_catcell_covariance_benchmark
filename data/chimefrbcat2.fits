erver name'                                          TTYPE2  = 'previous_name'      / label for column 2                             TFORM2  = '16A     '           / format for column 2                            TCOMM2  = 'Previous name, if applicable'                                        TTYPE3  = 'repeater_name'      / label for column 3                             TFORM3  = '16A     '           / format for column 3                            TCOMM3  = 'Associated repeater name, if applicable'                             TTYPE4  = 'event_id'           / label for column 4                             TFORM4  = '16A     '           / format for column 4                            TCOMM4  = 'CHIME/FRB internal event identifier'                                 TTYPE5  = 'sub_num '           / label for column 5                             TFORM5  = 'K       '           / format for column 5                            TCOMM5  = 'Sub-burst number (0 for single-burst FRBs; otherwise, assigned in &' CONTINUE  'chronological order)'                                                TTYPE6  = 'ra      '           / label for column 6                             TFORM6  = 'D       '           / format for column 6                            TUNIT6  = 'deg     '           / units for column 6                             TCOMM6  = 'Right ascension in decimal degrees (J2000)'                          TTYPE7  = 'ra_err  '           / label for column 7                             TFORM7  = 'D       '           / format for column 7                            TUNIT7  = 'deg     '           / units for column 7                             TCOMM7  = 'Uncertainty in ra in degrees of arc'                                 TTYPE8  = 'dec     '           / label for column 8                             TFORM8  = 'D       '           / format for column 8                            TUNIT8  = 'deg     '           / units for column 8                             TCOMM8  = 'Declination in d